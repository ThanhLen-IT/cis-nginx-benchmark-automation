# CIS 2.5.3 - Protect hidden files
server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html index.htm;

    include /etc/nginx/snippets/cis-deny-hidden.conf;

    error_page 500 502 503 504 /50x.html;

    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
