pid {{ cis_prefix.path }}/nginx.pid;
error_log {{ cis_prefix.path }}/error.log;
worker_processes 1;
events { worker_connections 128; }
http {
  access_log off;
{% if cis_test_hardened %}
  client_header_timeout 10s;
  client_body_timeout 10s;
  send_timeout 10s;
  client_max_body_size 2M;
  large_client_header_buffers 4 8k;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{% endif %}
  ssl_protocols TLSv1.3;
  server { listen {{ cis_http_port }}; server_name cis.local; return 301 https://cis.local:{{ cis_https_port }}$request_uri; }
  server {
    listen {{ cis_https_port }} ssl;
    server_name cis.local;
    ssl_certificate {{ cis_prefix.path }}/lab.crt;
    ssl_certificate_key {{ cis_prefix.path }}/lab.key;
    root {{ cis_prefix.path }};
    location / { try_files $uri $uri/ =404; }
  }
}
